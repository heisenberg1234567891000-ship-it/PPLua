<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>PPLua</AssemblyName>
    <RootNamespace>PPLua</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Version>0.8.0</Version>
    <Deterministic>true</Deterministic>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <!-- Point these at your own install; nothing from the game is shipped. -->
    <GameDir Condition="'$(GameDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\People Playground</GameDir>
    <ManagedDir>$(GameDir)\People Playground_Data\Managed</ManagedDir>
    <BepInExDir Condition="'$(BepInExDir)' == ''">$(GameDir)\BepInEx</BepInExDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MoonSharp" Version="2.0.0" Publicize="true" />
    <PackageReference Include="BepInEx.AssemblyPublicizer.MSBuild" Version="0.4.3" PrivateAssets="all" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="BepInEx" Private="false" HintPath="$(BepInExDir)\core\BepInEx.dll" />
    <Reference Include="0Harmony" Private="false" HintPath="$(BepInExDir)\core\0Harmony.dll" />
    <Reference Include="Assembly-CSharp" Private="false" Publicize="true" HintPath="$(ManagedDir)\Assembly-CSharp.dll" />
    <Reference Include="Newtonsoft.Json" Private="false" HintPath="$(ManagedDir)\Newtonsoft.Json.dll" />
    <Reference Include="UnityEngine" Private="false" HintPath="$(ManagedDir)\UnityEngine.dll" />
    <Reference Include="UnityEngine.CoreModule" Private="false" HintPath="$(ManagedDir)\UnityEngine.CoreModule.dll" />
    <Reference Include="UnityEngine.Physics2DModule" Private="false" HintPath="$(ManagedDir)\UnityEngine.Physics2DModule.dll" />
    <Reference Include="UnityEngine.AudioModule" Private="false" HintPath="$(ManagedDir)\UnityEngine.AudioModule.dll" />
    <Reference Include="UnityEngine.IMGUIModule" Private="false" HintPath="$(ManagedDir)\UnityEngine.IMGUIModule.dll" />
    <Reference Include="UnityEngine.InputLegacyModule" Private="false" HintPath="$(ManagedDir)\UnityEngine.InputLegacyModule.dll" />
    <Reference Include="UnityEngine.ImageConversionModule" Private="false" HintPath="$(ManagedDir)\UnityEngine.ImageConversionModule.dll" />
    <Reference Include="UnityEngine.TextRenderingModule" Private="false" HintPath="$(ManagedDir)\UnityEngine.TextRenderingModule.dll" />
  </ItemGroup>

</Project>
