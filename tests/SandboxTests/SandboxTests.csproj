<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <GameDir Condition="'$(GameDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\People Playground</GameDir>
    <BepInExDir Condition="'$(BepInExDir)' == ''">$(GameDir)\BepInEx</BepInExDir>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="MoonSharp" Version="2.0.0" Publicize="true" />
    <PackageReference Include="BepInEx.AssemblyPublicizer.MSBuild" Version="0.4.3" PrivateAssets="all" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <Compile Include="..\..\src\Sandbox.cs" Link="Sandbox.cs" />
    <Compile Include="..\..\src\MoonSharpFixes.cs" Link="MoonSharpFixes.cs" />
    <!-- On a machine without the game (CI) the same HarmonyX that BepInEx 5.4.23.5 ships comes from NuGet. -->
    <Reference Include="0Harmony" HintPath="$(BepInExDir)\core\0Harmony.dll" Condition="Exists('$(BepInExDir)\core\0Harmony.dll')" />
    <PackageReference Include="HarmonyX" Version="2.9.0" Condition="!Exists('$(BepInExDir)\core\0Harmony.dll')" />
  </ItemGroup>
</Project>
